# ---- Roster source -------------------------------------------------------
# "gsheet" (default) or "xlsx"
ROSTER_SOURCE=gsheet

# Google Sheets: the long id from the sheet URL
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GSHEET_ID=
# Tab name (not the file name). Defaults to the first tab if blank.
GSHEET_TAB=Sheet1
# Path to the service-account key JSON. On the runner this is written
# from the GOOGLE_SA_KEY secret at run start and deleted afterwards.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# xlsx fallback (only used when ROSTER_SOURCE=xlsx)
XLSX_PATH=./data/birthdays.xlsx
XLSX_SHEET=

# ---- Notifications -------------------------------------------------------
# Your own number in E.164, receives the post-run summary. Leave blank to disable.
SELF_NOTIFY_NUMBER=+919999999999

# ---- Runtime -------------------------------------------------------------
# Where the WhatsApp session, ledger and logs are kept. MUST be outside the
# repo workspace: GitHub Actions wipes the workspace on every checkout.
# Defaults to %USERPROFILE%\.wa-birthday-bot
# BOT_HOME=C:\Users\you\.wa-birthday-bot

# true = resolve and schedule everything, send nothing
DRY_RUN=false
